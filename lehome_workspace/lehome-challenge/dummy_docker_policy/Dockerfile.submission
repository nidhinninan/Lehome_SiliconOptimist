# Use the official PyTorch image with CUDA support. 
FROM pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# Create a non-root user (Hugging Face standard)
RUN useradd -m -u 1000 user
WORKDIR /app

# Prevent Python from writing pyc files and keep stdout unbuffered
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/user
ENV PATH=/home/user/.local/bin:$PATH

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install required Python packages. 
COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the server and policy scripts
COPY --chown=user server.py policy.py ./

# Copy the pre-downloaded W&B checkpoint into the image
COPY --chown=user pretrained_model/ /app/pretrained_model/

# Set user
USER user

# Expose the HTTP port expected by the LeHome eval script
EXPOSE 8080

# Run the policy server
CMD ["python", "policy.py"]
